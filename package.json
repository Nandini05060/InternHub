{
  "name": "internhub-monorepo",
  "version": "1.0.0",
  "description": "InternHub — Internship Discovery and Application Management Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm run install:server && npm run install:client",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "db:init": "cd server && npm run db:init",
    "db:seed": "cd server && npm run db:seed",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test": "npm run test:server && npm run test:client",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "InternHub Team",
  "license": "MIT"
}
